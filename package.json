{
  "name": "@mdadul/db-mcp",
  "version": "1.1.0",
  "type": "module",
  "description": "Self-hosted read-only database gateway for MCP-compatible AI tools",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "database",
    "postgres",
    "mysql",
    "sqlite",
    "ai",
    "llm"
  ],
  "license": "MIT",
  "author": "mdadul",
  "homepage": "https://github.com/mdadul/db-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdadul/db-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/mdadul/db-mcp/issues"
  },
  "bin": {
    "db-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "client/dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@hono/zod-validator": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "scripts": {
    "setup": "sh scripts/setup.sh",
    "start": "node dist/cli.js",
    "dev": "sh scripts/setup.sh && node --env-file=.env --watch src/index.ts",
    "build:server": "tsc -p tsconfig.build.json && rm -rf dist/db/migrations && cp -R src/db/migrations dist/db/migrations",
    "build": "sh scripts/build-package.sh",
    "ci": "npm run build",
    "prepack": "sh scripts/build-package.sh",
    "prepublishOnly": "npm run ci",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts",
    "build:client": "cd client && bun install && bun run build",
    "dev:client": "cd client && bun run dev"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
