# =============================================================================
# DB MCP Gateway — Environment Variables
# Copy to .env and fill in the values.
# =============================================================================

# SQLite file path for the gateway's internal control-plane database.
# This stores your database connection metadata (NOT your actual business data).
DATABASE_PATH=./data/db-mcp.sqlite

# 32-byte (64 hex characters) encryption key for stored database credentials.
# Generate with:  openssl rand -hex 32
# NEVER commit this value. If lost, stored credentials cannot be recovered.
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# Bearer token for MCP endpoint authentication.
# Used by Claude Code / Codex to connect: Authorization: Bearer <MCP_TOKEN>
# Generate with:  openssl rand -base64 32
MCP_TOKEN=change_me_generate_with_openssl_rand_base64_32

# Optional: port to run the gateway on (default: 4080)
# PORT=4080
