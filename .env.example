# =============================================================================
# DB MCP Gateway — Environment Variables
# Copy to .env and fill in the values.
# =============================================================================

# SQLite file path for the gateway's internal control-plane database.
# This stores your database connection metadata (NOT your actual business data).
DATABASE_PATH=./data/db-mcp.sqlite

# 32-byte (64 hex characters) encryption key for stored database credentials.
# Generate with:  openssl rand -hex 32
# NEVER commit this value. If lost, stored credentials cannot be recovered.
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# Optional: address to bind to (default: 127.0.0.1). Keep it on loopback so the
# gateway is reachable only from this machine.
# HOST=127.0.0.1

# Optional: port to run the gateway on (default: 4080)
# PORT=4080

# Optional: if set, every /api request except GET /api/health must send
# "X-App-Session: <token>". The desktop app sets this for its own UI. Leave it
# unset for local development.
# Generate with:  openssl rand -hex 32
# APP_SESSION_TOKEN=

# Optional: extra browser origins allowed to call /api, comma-separated
# (the desktop app's own origins are always allowed).
# Example for the Vite dev server: http://localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173
