{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@server/*": [
        "../src/*"
      ],
      "hono": [
        "../node_modules/hono/dist/types/index.d.ts"
      ],
      "hono/client": [
        "../node_modules/hono/dist/types/client/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
