{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB MCP",
  "version": "0.1.0",
  "identifier": "dev.dbmcp.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "node scripts/build-sidecar.mjs && bun run --cwd client dev --host 127.0.0.1",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "bun run --cwd client build && node scripts/build-sidecar.mjs",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DB MCP",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/server/": "server/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
