---
import Icon from "./Icon.astro";

type Win = "chat" | "db";
type Kind = "user" | "ai" | "cmd" | "err" | "ok" | "tool";
interface Step {
  win: Win;
  kind: Kind;
  caption: string;
  clock: string; // simulated elapsed time shown in the counter
  paste?: boolean; // this step involves a copy-paste
  wrong?: boolean; // the AI produced a wrong query here
  text?: string;
  code?: string;
  tool?: string;
  arg?: string;
  result?: string;
}

const question = "Which customers churned last month, and what plan were they on?";

const before: Step[] = [
  {
    win: "chat",
    kind: "user",
    text: question,
    caption: "You ask the AI a question about your data.",
    clock: "0:10",
  },
  {
    win: "chat",
    kind: "ai",
    text: "I can't see your database. Could you paste the table definitions for customers and plans?",
    caption: "The AI has never seen your schema, so it asks you for it.",
    clock: "0:20",
  },
  {
    win: "db",
    kind: "cmd",
    code: "\\d customers\n\\d customer_plans",
    result: 'Table "public.customers" … 14 columns',
    caption: "You open your DB client and look up the tables.",
    clock: "1:40",
  },
  {
    win: "chat",
    kind: "user",
    paste: true,
    code: "CREATE TABLE customers (\n  id uuid, name text, churned_at timestamptz, …\n);",
    caption: "You copy the schema and paste it into the chat.",
    clock: "2:10",
  },
  {
    win: "chat",
    kind: "ai",
    wrong: true,
    code: "SELECT c.name, p.plan_name\nFROM customers c JOIN customer_plans p ON …\nWHERE c.churned_at >= now() - interval '1 month'",
    caption: "The AI writes a query from what you pasted. It guesses a column name.",
    clock: "2:30",
  },
  {
    win: "db",
    kind: "err",
    paste: true,
    code: "SELECT c.name, p.plan_name …",
    result: "ERROR: column p.plan_name does not exist",
    caption: "You paste it into the DB client and run it. It fails.",
    clock: "3:20",
  },
  {
    win: "chat",
    kind: "user",
    paste: true,
    code: "ERROR: column p.plan_name does not exist",
    caption: "You copy the error back to the AI.",
    clock: "3:45",
  },
  {
    win: "chat",
    kind: "ai",
    code: "Sorry about that! Try:\nSELECT c.name, p.plan, c.churned_at …",
    caption: "The AI apologizes and tries again.",
    clock: "4:05",
  },
  {
    win: "db",
    kind: "ok",
    paste: true,
    code: "SELECT c.name, p.plan, c.churned_at …",
    result: "14 rows · Export → Copy as CSV",
    caption: "Back to the DB client. Paste, run, then export the rows.",
    clock: "5:30",
  },
  {
    win: "chat",
    kind: "user",
    paste: true,
    code: "name,plan,churned_at\nAcme Co,Starter,2026-10-03\n… 13 more rows",
    caption: "You paste the results into the chat.",
    clock: "6:15",
  },
  {
    win: "chat",
    kind: "ai",
    text: "14 customers churned in October. 9 were on Starter, 4 on Team, 1 on Business.",
    caption: "Finally, an answer. And the next question starts the loop again.",
    clock: "6:40",
  },
];

const after: Step[] = [
  {
    win: "chat",
    kind: "user",
    text: question,
    caption: "You ask the same question.",
    clock: "0:03",
  },
  {
    win: "chat",
    kind: "tool",
    tool: "list_databases",
    result: "prod_replica, analytics",
    caption: "The agent finds your databases on its own.",
    clock: "0:05",
  },
  {
    win: "chat",
    kind: "tool",
    tool: "get_database_schema",
    arg: 'filter: "customer"',
    result: "customers, customer_plans, customer_events",
    caption: "It searches the schema for relevant tables.",
    clock: "0:08",
  },
  {
    win: "chat",
    kind: "tool",
    tool: "get_table_schema",
    arg: "customer_plans",
    result: "id, customer_id, plan, started_at, …",
    caption: "It reads the real columns, so it doesn’t have to guess.",
    clock: "0:11",
  },
  {
    win: "chat",
    kind: "tool",
    tool: "execute_read_query",
    code: "SELECT c.name, p.plan, c.churned_at\nFROM customers c JOIN customer_plans p ON p.customer_id = c.id\nWHERE c.churned_at >= '2026-10-01'",
    result: "✓ 14 rows · 38 ms · read-only",
    caption: "It runs a correct, read-only query. First try.",
    clock: "0:15",
  },
  {
    win: "chat",
    kind: "ai",
    text: "14 customers churned in October. 9 were on Starter, 4 on Team, 1 on Business. Most left within 30 days of a price change.",
    caption: "You get the answer, with no app switching and no copy-paste.",
    clock: "0:21",
  },
];

const modes = [
  { id: "before", label: "Without DB MCP", steps: before },
  { id: "after", label: "With DB MCP", steps: after },
] as const;

// Totals for the summary cards, derived from the same script as the simulation.
const totals = (steps: Step[]) => ({
  switches: steps.filter((s, i) => i > 0 && s.win !== steps[i - 1].win).length,
  pastes: steps.filter((s) => s.paste).length,
  wrong: steps.filter((s) => s.wrong).length,
  clock: steps[steps.length - 1].clock,
});
const tb = totals(before);
const ta = totals(after);
const fmt = (clock: string) => {
  const [m, sec] = clock.split(":").map(Number);
  return m ? `${m}m ${sec}s` : `${sec}s`;
};
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const tag = (k: Kind) => (k === "user" ? "You" : k === "ai" ? "AI" : "");
---

<section class="section compare" id="compare">
  <div class="container">
    <div class="section-head reveal">
      <span class="kicker">Before &amp; after</span>
      <h2>
        Stop being your AI’s
        <br />
        <span class="grad-text">copy-paste middleware</span>
      </h2>
      <p>
        Without database access, every question turns into a loop between the chat and your DB
        client. With DB MCP, the agent does the legwork itself.
      </p>
    </div>

    <div class="sim reveal" data-sim>
      <div class="toolbar">
        <div class="seg" role="tablist" aria-label="Workflow">
          {modes.map((m, i) => (
            <button
              type="button"
              role="tab"
              data-mode-btn={m.id}
              aria-selected={i === 0 ? "true" : "false"}
              class={m.id}
            >
              {m.id === "before" ? <Icon name="ban" size={15} /> : <Icon name="zap" size={15} />}
              {m.label}
            </button>
          ))}
        </div>

        <dl class="stats" aria-live="off">
          <div>
            <dt>Time</dt>
            <dd data-stat="clock">0:00</dd>
          </div>
          <div>
            <dt>App switches</dt>
            <dd data-stat="switches">0</dd>
          </div>
          <div>
            <dt>Copy-pastes</dt>
            <dd data-stat="pastes">0</dd>
          </div>
          <div>
            <dt>Wrong queries</dt>
            <dd data-stat="wrong">0</dd>
          </div>
        </dl>
      </div>

      {modes.map((m, mi) => (
        <div class={`stage stage-${m.id}`} data-stage={m.id} hidden={mi !== 0}>
          <div class="win chat" data-win="chat">
            <div class="bar">
              <span class="dots">
                <i />
                <i />
                <i />
              </span>
              <span class="wtitle">
                {m.id === "before" ? "AI chat" : "AI agent · db-mcp connected"}
              </span>
            </div>
            <div class="feed" data-feed>
              {m.steps.map((s, i) =>
                s.win === "chat" ? (
                  <div class={`msg ${s.kind}${s.wrong ? " wrong" : ""}`} data-step={i}>
                    {s.kind === "tool" ? (
                      <>
                        <div class="tool-head">
                          <span class="tdot" />
                          <b>db-mcp</b> · {s.tool}
                          {s.arg && <span class="targ">{s.arg}</span>}
                        </div>
                        {s.code && <pre>{s.code}</pre>}
                        <span class="tres">{s.result}</span>
                      </>
                    ) : (
                      <>
                        <span class="who">
                          {tag(s.kind)}
                          {s.paste && <em class="chip paste">pasted</em>}
                          {s.wrong && <em class="chip bad">wrong column</em>}
                        </span>
                        {s.text && <p>{s.text}</p>}
                        {s.code && <pre>{s.code}</pre>}
                      </>
                    )}
                  </div>
                ) : null,
              )}
            </div>
          </div>

          {m.id === "before" && (
            <>
              <div class="loop" aria-hidden="true">
                <span class="arrow a1">
                  <Icon name="arrow" size={18} />
                </span>
                <span class="loop-label">copy · paste · repeat</span>
                <span class="arrow a2">
                  <Icon name="arrow" size={18} />
                </span>
              </div>
              <div class="win db" data-win="db">
                <div class="bar">
                  <span class="dots">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="wtitle">DB client · prod_replica</span>
                </div>
                <div class="feed" data-feed>
                  {m.steps.map((s, i) =>
                    s.win === "db" ? (
                      <div class={`row ${s.kind}`} data-step={i}>
                        <pre class="sqlin"><span class="pr">db=&gt; </span>{s.code}</pre>
                        <span class="out">{s.result}</span>
                      </div>
                    ) : null,
                  )}
                  <p class="idle">Waiting for you to paste a query…</p>
                </div>
              </div>
            </>
          )}

          <div class="toast" data-toast aria-hidden="true">
            <Icon name="copy" size={14} /> <span>Copy &amp; paste</span>
          </div>
        </div>
      ))}

      <div class="simbar">
        <div class="caption">
          <span class="stepno mono" data-stepno>
            01
          </span>
          <span data-caption>Press play to see the loop.</span>
        </div>
        <div class="progress" aria-hidden="true">
          <i data-progress></i>
        </div>
        <button type="button" class="replay" data-replay>
          <Icon name="sparkles" size={15} />
          <span>Replay</span>
        </button>
      </div>

      <script type="application/json" data-steps set:html={JSON.stringify({ before, after })} />
    </div>

    <div class="verdict reveal">
      <div class="v before">
        <span class="vlabel">Without DB MCP</span>
        <b>{fmt(tb.clock)}</b>
        <span>
          {plural(tb.switches, "app switch", "app switches")},{" "}
          {plural(tb.pastes, "copy-paste", "copy-pastes")},{" "}
          {plural(tb.wrong, "wrong query", "wrong queries")}. Every question.
        </span>
      </div>
      <span class="vs" aria-hidden="true">
        <Icon name="arrow" size={20} />
      </span>
      <div class="v after">
        <span class="vlabel">With DB MCP</span>
        <b>{fmt(ta.clock)}</b>
        <span>Zero app switches, zero copy-pastes. The agent reads the schema first.</span>
      </div>
    </div>
  </div>
</section>

<script>
  type Step = {
    win: "chat" | "db";
    clock: string;
    caption: string;
    paste?: boolean;
    wrong?: boolean;
  };
  type Data = Record<"before" | "after", Step[]>;

  const root = document.querySelector<HTMLElement>("[data-sim]");
  if (root) init(root);

  function init(root: HTMLElement) {
    const data: Data = JSON.parse(root.querySelector("[data-steps]")!.textContent ?? "{}");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = <T extends HTMLElement>(sel: string, el: ParentNode = root) =>
      el.querySelector<T>(sel)!;
    const stat = (k: string) => $(`[data-stat="${k}"]`);
    const caption = $("[data-caption]");
    const stepno = $("[data-stepno]");
    const progress = $("[data-progress]");
    const replay = $<HTMLButtonElement>("[data-replay]");

    let mode: keyof Data = "before";
    let timer: number | undefined;
    let started = false;

    const DELAY = { before: 1900, after: 1300 };

    function stop() {
      if (timer) window.clearTimeout(timer);
      timer = undefined;
    }

    function setMode(next: keyof Data) {
      mode = next;
      root.dataset.mode = next;
      root
        .querySelectorAll<HTMLButtonElement>("[data-mode-btn]")
        .forEach((b) => b.setAttribute("aria-selected", String(b.dataset.modeBtn === next)));
      root
        .querySelectorAll<HTMLElement>("[data-stage]")
        .forEach((s) => (s.hidden = s.dataset.stage !== next));
    }

    function render(i: number) {
      const steps = data[mode];
      const stage = $(`[data-stage="${mode}"]`);
      let switches = 0;
      let pastes = 0;
      let wrong = 0;
      for (let k = 0; k <= i; k++) {
        if (k > 0 && steps[k].win !== steps[k - 1].win) switches++;
        if (steps[k].paste) pastes++;
        if (steps[k].wrong) wrong++;
      }
      stage.querySelectorAll<HTMLElement>("[data-step]").forEach((el) => {
        const on = Number(el.dataset.step) <= i;
        el.classList.toggle("shown", on);
        el.classList.toggle("latest", Number(el.dataset.step) === i);
      });
      stage.querySelectorAll<HTMLElement>("[data-win]").forEach((w) => {
        w.classList.toggle("active", i >= 0 && steps[i].win === w.dataset.win);
      });
      stage.querySelectorAll<HTMLElement>("[data-feed]").forEach((f) => {
        f.scrollTo({ top: f.scrollHeight, behavior: reduce ? "auto" : "smooth" });
      });

      const toast = $("[data-toast]", stage);
      toast.classList.remove("pop");
      if (i >= 0 && steps[i].paste && !reduce) {
        toast.dataset.side = steps[i].win;
        void toast.offsetWidth;
        toast.classList.add("pop");
      }

      const s = i >= 0 ? steps[i] : null;
      stat("clock").textContent = s ? s.clock : "0:00";
      stat("switches").textContent = String(switches);
      stat("pastes").textContent = String(pastes);
      stat("wrong").textContent = String(wrong);
      caption.textContent = s ? s.caption : "";
      stepno.textContent = String(Math.max(i + 1, 1)).padStart(2, "0");
      progress.style.width = `${((i + 1) / steps.length) * 100}%`;
      root.classList.toggle("done", i === steps.length - 1);
    }

    function play(from = 0, chain = false) {
      stop();
      const steps = data[mode];
      if (reduce) {
        render(steps.length - 1);
        return;
      }
      let i = from;
      const tick = () => {
        render(i);
        if (i < steps.length - 1) {
          i++;
          timer = window.setTimeout(tick, DELAY[mode]);
        } else if (chain && mode === "before") {
          // Tell the whole story: after the loop finishes, show the fix.
          timer = window.setTimeout(() => {
            setMode("after");
            play(0);
          }, 2600);
        }
      };
      tick();
    }

    root.querySelectorAll<HTMLButtonElement>("[data-mode-btn]").forEach((b) =>
      b.addEventListener("click", () => {
        started = true;
        setMode(b.dataset.modeBtn as keyof Data);
        play(0);
      }),
    );
    replay.addEventListener("click", () => {
      started = true;
      play(0, mode === "before");
    });

    setMode("before");
    render(-1);

    // Start once, the first time the simulation scrolls into view.
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting && !started) {
          started = true;
          play(0, true);
        }
      },
      { threshold: 0.35 },
    ).observe(root);
  }
</script>

<style>
  .sim {
    border-radius: 20px;
    border: 1px solid var(--line-strong);
    background: linear-gradient(180deg, #0c1120, #090c16);
    box-shadow: 0 40px 100px -40px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }

  /* ---- toolbar ---- */
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .seg {
    display: inline-flex;
    padding: 4px;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line);
  }
  .seg button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--mut);
    font: 600 14px var(--sans);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .seg button:hover {
    color: var(--fg);
  }
  .seg button.before[aria-selected="true"] {
    background: rgba(248, 113, 113, 0.14);
    color: #fca5a5;
  }
  .seg button.after[aria-selected="true"] {
    background: rgba(34, 211, 238, 0.14);
    color: var(--cyan);
  }
  .stats {
    display: flex;
    gap: 6px;
    margin: 0;
  }
  .stats div {
    min-width: 92px;
    padding: 6px 12px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
  }
  .stats dt {
    font-size: 11px;
    color: var(--mut);
    white-space: nowrap;
  }
  .stats dd {
    margin: 0;
    font: 600 17px/1.3 var(--mono);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
  }
  [data-mode="before"] .stats dd {
    color: #fca5a5;
  }
  [data-mode="after"] .stats dd {
    color: var(--green);
  }

  /* ---- stage ---- */
  .stage {
    position: relative;
    display: grid;
    gap: 0;
    padding: 20px;
    height: 470px;
  }
  .stage[hidden] {
    display: none;
  }
  .stage-before {
    grid-template-columns: minmax(0, 1fr) 88px minmax(0, 1fr);
  }
  .stage-after {
    grid-template-columns: minmax(0, 1fr);
    max-width: 760px;
    margin: 0 auto;
    width: 100%;
  }
  .win {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: #0a0e19;
    overflow: hidden;
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      opacity 0.35s ease;
  }
  .stage-before .win:not(.active) {
    opacity: 0.55;
  }
  .win.active {
    border-color: rgba(34, 211, 238, 0.55);
    box-shadow:
      0 0 0 3px rgba(34, 211, 238, 0.08),
      0 0 50px -12px rgba(34, 211, 238, 0.45);
    opacity: 1;
  }
  .stage-before .win.db.active {
    border-color: rgba(251, 191, 36, 0.55);
    box-shadow:
      0 0 0 3px rgba(251, 191, 36, 0.08),
      0 0 50px -12px rgba(251, 191, 36, 0.4);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 38px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    flex: none;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2a3146;
  }
  .wtitle {
    font: 12px var(--mono);
    color: var(--mut);
  }
  .feed {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scrollbar-width: thin;
    scrollbar-color: #232b44 transparent;
  }

  /* messages */
  [data-step] {
    display: none;
  }
  [data-step].shown {
    display: block;
    animation: pop-in 0.4s ease both;
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .msg {
    max-width: 88%;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 14px;
  }
  .msg p {
    margin: 0;
  }
  .msg.user {
    align-self: flex-end;
    background: rgba(59, 130, 246, 0.16);
    border: 1px solid rgba(59, 130, 246, 0.25);
  }
  .msg.ai {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line);
  }
  .msg.wrong {
    border-color: rgba(248, 113, 113, 0.45);
  }
  .who {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 600;
    color: var(--mut);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .chip {
    font-style: normal;
    text-transform: none;
    letter-spacing: 0;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 11px;
  }
  .chip.paste {
    background: rgba(251, 191, 36, 0.15);
    color: var(--amber);
  }
  .chip.bad {
    background: rgba(248, 113, 113, 0.15);
    color: var(--red);
  }
  pre {
    margin: 4px 0 0;
    padding: 8px 10px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.35);
    font: 12px/1.55 var(--mono);
    color: #c8d3ea;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* agent tool calls */
  .msg.tool {
    max-width: 100%;
    align-self: stretch;
    padding: 4px 2px;
    font: 13px/1.6 var(--mono);
    color: var(--fg-2);
  }
  .tool-head b {
    color: var(--fg);
  }
  .tdot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--green);
  }
  .targ {
    margin-left: 8px;
    color: var(--amber);
  }
  .tres {
    display: block;
    padding-left: 16px;
    color: var(--mut);
  }
  .tres::before {
    content: "└ ";
    color: #3a4460;
  }
  .msg.tool pre {
    margin-left: 16px;
  }
  .msg.tool.latest .tdot {
    animation: blink 0.8s ease 2;
  }
  @keyframes blink {
    50% {
      opacity: 0.2;
    }
  }
  .stage-after .msg.ai {
    border-color: rgba(52, 211, 153, 0.35);
    background: rgba(52, 211, 153, 0.06);
  }

  /* DB client rows */
  .row {
    font: 12.5px/1.55 var(--mono);
  }
  .sqlin {
    margin: 0;
    background: transparent;
    padding: 0;
